# ==============================================================================
# VyNexa Connect - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Frontend Vite Supabase Keys (Exposed to Client)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# Dual AI / LLM Provider Layer (Primary & Secondary Fallback)
# ------------------------------------------------------------------------------
# 1. Primary Provider: Google AI Studio (Gemini API)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 2. Secondary / Fallback Provider: OpenRouter (OpenAI-compatible)
# Used automatically if Gemini hits rate limits (429), quota exhaustion, or server errors.
# Also supports explicit overrides to route tasks directly to models like
# google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, or meta-llama/llama-3.3-70b-instruct.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# ------------------------------------------------------------------------------
# Email Integration (Resend & Brevo)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_..."
BREVO_API_KEY="xkeysib-..."

# ------------------------------------------------------------------------------
# SMS Integration (Twilio & TextBee)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_PHONE_NUMBER=""

TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (Certificates, PDFs, CBT Papers)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET_NAME="vynexa-storage"
VITE_CLOUDFLARE_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# ------------------------------------------------------------------------------
# Cloudflare RealtimeKit & TURN
# ------------------------------------------------------------------------------
CLOUDFLARE_REALTIME_APP_ID=""
CLOUDFLARE_REALTIME_APP_SECRET=""
CLOUDFLARE_REALTIME_API_TOKEN=""
CLOUDFLARE_TURN_TOKEN_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# ------------------------------------------------------------------------------
# Payment Gateway (PayU)
# ------------------------------------------------------------------------------
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
