import { createClient } from "@supabase/supabase-js";
import dotenv from "dotenv";

dotenv.config({ path: ".env.local" });
dotenv.config({ path: ".env" }); // fallback

const supabaseUrl = process.env.VITE_SUPABASE_URL;
const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

if (!supabaseUrl || !supabaseKey) {
  console.error("Missing Supabase credentials");
  process.exit(1);
}

const supabase = createClient(supabaseUrl, supabaseKey);

async function run() {
  console.log("Listing NOCs...");
  const { data: files, error: listErr } = await supabase.storage.from('default').list('nocs', { limit: 1000 });
  
  if (listErr) {
    console.error('List error:', listErr);
    return;
  }
  
  if (files && files.length > 0) {
    const filePaths = files.map(f => 'nocs/' + f.name);
    console.log(`Found ${filePaths.length} NOCs. Deleting...`);
    const { error: rmErr } = await supabase.storage.from('default').remove(filePaths);
    if (rmErr) {
      console.error('Remove error:', rmErr);
    } else {
      console.log('Successfully deleted ' + filePaths.length + ' NOCs.');
    }
  } else {
    console.log("No NOCs found to delete.");
  }
  
  console.log("Clearing noc_url in applications...");
  const { error: updateErr } = await supabase.from('applications').update({ noc_url: null }).not('noc_url', 'is', null);
  if (updateErr) {
    console.error('Update error:', updateErr);
  } else {
    console.log('Cleared NOC URLs in DB.');
  }
}
run();
