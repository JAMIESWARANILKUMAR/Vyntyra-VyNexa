{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyntyra-vynexa",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "vars": {
    "SUPABASE_URL": "https://yvcocxnucmqxigrgkzha.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_tPu7MwjyM1jh0TLGDr7-CA_biaOnQp8",
    "SUPABASE_SERVICE_ROLE_KEY": "PASTE_YOUR_SERVICE_ROLE_KEY_HERE"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
  // If you configure a Cloudflare D1 database in the future, uncomment below and provide your real D1 database details:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "your-database-name",
  //     "database_id": "your-database-uuid"
  //   }
  // ]
}